def caesar(text, k):
    result = ""
    for ch in text:
        if ch.isalpha():
            base = ord('A') if ch.isupper() else ord('a')
            result += chr((ord(ch) - base + k) % 26 + base)
        else:
            result += ch
    return result

text = input("Enter text: ")
k = int(input("Enter key (1-25): "))

print("Encrypted:", caesar(text, k))
print("Decrypted:", caesar(caesar(text, k), -k))
