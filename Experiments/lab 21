def padding(data, block_size):
    pad_len = block_size - (len(data) % block_size)

    if pad_len == 0:
        pad_len = block_size

    return data + b'\x80' + b'\x00' * (pad_len - 1)


text = input("Enter message: ").encode()

padded = padding(text, 8)

print("Original:", text)
print("Padded:", padded)
