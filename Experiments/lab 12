import numpy as np

K = np.array([[9,4],
              [5,7]])

text = input("Enter plaintext: ").lower()
text = ''.join(c for c in text if c.isalpha())

if len(text) % 2:
    text += 'x'

result = ""

for i in range(0,len(text),2):
    p = np.array([[ord(text[i])-97],
                  [ord(text[i+1])-97]])

    c = np.dot(K,p) % 26

    result += chr(int(c[0][0])+97)
    result += chr(int(c[1][0])+97)

print("Ciphertext:", result)
