def left_shift(block, bits):
    return ((block << 1) & ((1 << bits)-1))


def cmac_subkey(L, bits):
    if bits == 64:
        Rb = 0x1B
    elif bits == 128:
        Rb = 0x87
    else:
        raise ValueError("Unsupported block size")

    K1 = left_shift(L,bits)

    if (L >> (bits-1)) & 1:
        K1 ^= Rb

    K2 = left_shift(K1,bits)

    if (K1 >> (bits-1)) & 1:
        K2 ^= Rb

    return K1,K2


L = int(input("Enter L in hex: "),16)
bits = int(input("Enter block size 64 or 128: "))

K1,K2 = cmac_subkey(L,bits)

print("K1 =",hex(K1))
print("K2 =",hex(K2))
